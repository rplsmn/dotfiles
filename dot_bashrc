parse_git_branch() {
    git branch 2>/dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
}

PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[33m\]$(parse_git_branch)\[\033[00m\]\$ '

# --- Shared artifact helpers ---

# Detect repo name from current directory
_artifact_repo_name() {
  basename "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null || true
}

# Ensure artifact dir exists, print path. Returns 1 if no repo detected.
_artifact_ensure_dir() {
  local artifacts_root="${ARTIFACTS_DIR:-$HOME/.artifacts}"
  local repo_name
  repo_name="$(_artifact_repo_name)"

  if [[ -z "$repo_name" ]]; then
    return 1
  fi

  local artifact_dir="${artifacts_root}/${repo_name}"
  if [[ ! -d "$artifact_dir" ]]; then
    mkdir -p "${artifact_dir}"/{plans,research,sessions,archive}
    echo "⚡ Created artifact dir: ${artifact_dir}" >&2
  fi

  echo "$artifact_dir"
}

# Auto-commit + push artifacts if there are changes
_artifact_commit_and_push() {
  local artifacts_root="${ARTIFACTS_DIR:-$HOME/.artifacts}"
  local repo_name
  repo_name="$(_artifact_repo_name)"

  if [[ ! -d "$artifacts_root/.git" ]]; then
    return 0
  fi

  local has_changes=false
  if ! git -C "$artifacts_root" diff --quiet 2>/dev/null; then
    has_changes=true
  fi
  if [[ -n "$(git -C "$artifacts_root" ls-files --others --exclude-standard 2>/dev/null)" ]]; then
    has_changes=true
  fi

  if [[ "$has_changes" == true ]]; then
    git -C "$artifacts_root" add -A
    git -C "$artifacts_root" commit -m "${repo_name:-misc}: $(date +%Y-%m-%d-%H%M)" --quiet
    git -C "$artifacts_root" pull --rebase --autostash --quiet 2>/dev/null
    git -C "$artifacts_root" push --quiet 2>/dev/null &
    echo "📦 Artifacts committed & pushing..."
  fi
}

# --- Tool wrappers ---

_in_git_repo() {
  git rev-parse --is-inside-work-tree &>/dev/null
}

claude() {
  local extra_args=()
  if _in_git_repo; then
    local artifact_dir
    artifact_dir="$(_artifact_ensure_dir)" && extra_args+=(--add-dir "$artifact_dir")
    # Refresh activated specs from cold library (never adds new ones)
    specs-sync refresh --quiet 2>/dev/null || true
  fi

  command claude "${extra_args[@]}" "$@"
  local exit_code=$?

  if _in_git_repo; then
    _artifact_commit_and_push
  fi
  return $exit_code
}

copilot() {
  local extra_args=()
  if _in_git_repo; then
    local artifact_dir
    artifact_dir="$(_artifact_ensure_dir)" && extra_args+=(--add-dir "$artifact_dir")
    # Refresh activated specs from cold library (never adds new ones)
    specs-sync refresh --quiet 2>/dev/null || true
  fi

  command copilot "${extra_args[@]}" "$@"
  local exit_code=$?

  if _in_git_repo; then
    _artifact_commit_and_push
  fi
  return $exit_code
}

opencode() {
  local extra_args=()
  if _in_git_repo; then
    local artifact_dir
    artifact_dir="$(_artifact_ensure_dir)" && extra_args+=(--add-dir "$artifact_dir")
  fi

  command opencode "${extra_args[@]}" "$@"
  local exit_code=$?

  if _in_git_repo; then
    _artifact_commit_and_push
  fi
  return $exit_code
}
