parse_git_branch() {
    git branch 2>/dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
}

PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[33m\]$(parse_git_branch)\[\033[00m\]\$ '

function ssh-tmux() {
  ssh -t "$1" "tmux attach || tmux new -s remote"
}

# mosh sessions: Termius-mosh cannot render 24-bit color (mosh 1.3 lib).
# Drop to a palette TERM so tmux converts RGB hex to 256 colors for this
# client; truecolor SSH clients keep exact colors.
if [ -z "$TMUX" ] && [ -z "$HERDR_ENV" ] && ps -o comm= -p "$PPID" 2>/dev/null | grep -q '^mosh-server$'; then
  export TERM=screen-256color
fi

if [ -z "$TMUX" ] && [ -z "$HERDR_ENV" ]; then
  tmux attach -t default || tmux new -s default
fi

if command -v tmux &> /dev/null && [ -n "$PS1" ] && [[ ! "$TERM" =~ screen ]] && [[ ! "$TERM" =~ tmux ]] && [ -z "$TMUX" ] && [ -z "$HERDR_ENV" ]; then
  exec tmux
fi
